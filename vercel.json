{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/downloads/DIGITracker-latest.apk",
      "destination": "https://github.com/brianmuriiki/HideOut-creatives/releases/latest/download/DIGITracker-latest.apk",
      "permanent": false
    },
    {
      "source": "/downloads/Ziba-latest.apk",
      "destination": "https://github.com/brianmuriiki/Ziba-enterprises/releases/latest/download/Ziba-latest.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
